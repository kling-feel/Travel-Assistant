# Copy to .env and replace the password with your own local value.
# This file contains examples only. Never place a model API key in Git.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
JWT_SECRET_KEY=replace-with-a-random-secret
DEMO_TRAVELER_1_PASSWORD=replace-with-demo-password-1
DEMO_TRAVELER_2_PASSWORD=replace-with-demo-password-2

# Optional later: set these when the API is connected to PostgreSQL.
# DATABASE_URL=postgresql+psycopg://travel_app:<password>@127.0.0.1:5433/travel_demo
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-flash
# AI_API_KEY=<your-key>
# AI_BASE_URL=https://api.deepseek.com

# Optional real place sources for the controlled recommendation flow.
# Obtain a dedicated CleverSee HTTP API key; the adapter uses GlobalBasic only.
# ALIYUN_IQS_API_KEY=<your-key>
# ALIYUN_IQS_ENABLED=false  # Optional: explicitly disable live search.
